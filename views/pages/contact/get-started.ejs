    <script>
        // toggle indsutry text input
        let industry_select = document.getElementById('industry-select')
        let industry_text = document.getElementById('industry_text')
        let industry_select_value = '';
        industry_select.addEventListener('change', () => {
            industry_select_value = industry_select.value
            if (industry_select_value === 'other') {
                industry_text.classList.remove('d-none')
                industry_text.removeAttribute('disabled')
            } else {
                industry_text.classList.add('d-none')
                industry_text.setAttribute('disabled', 'disabled')
            }
        })

    </script>
