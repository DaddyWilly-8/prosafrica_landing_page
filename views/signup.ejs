<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Renol</title>
    <link href="/images/favicon.ico" rel="icon" type="images/x-icon" />
    <!-- remix icon  -->
    <link href="/css/remixicon.css" rel="stylesheet" />
    <!-- swiper -->
    <link href="/css/swiper-bundle.min.css" rel="stylesheet">
    <!-- bootstrap  -->
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/style.min.css" rel="stylesheet" />
    </link>
</head>

<body data-bs-spy="scroll" data-bs-target="#navbarCollapse">
    <section class="section signup-section bg-light">
        <div class="bg-overlay-2"></div>
        <div class="container">
            <div class="login-content bg-primary py-5 px-2 rounded-4">
                <div class="row align-items-center justify-content-evenly">
                    <div class="col-lg-5 text-start">
                        <div class="navbar-brand logo text-center">
                            <a class="navbar-caption fs-4 text-light ls-1 fw-bold" href="/#"><i
                                    class="ri-registered-fill text-success fs-3 me-1"></i>RENOL
                            </a>
                        </div>
                        <img alt="" class="img-fluid" src="/images/Sign up-cuate.png" />
                        <div class="footer-copyright-2">
                            <div class="copy-info text-center">
                                <div class="copy-info text-center text-white">
                                    ©
                                    <script>
                                        document.write(new Date().getFullYear())
                                    </script> Renol - <a class="text-white-50 text-decoration-underline"
                                        href="/#">Themesdesign
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="card border-0 rounded-4">
                            <div class="card-body">
                                <div class="text-center mt-3">
                                    <div class="login-title">
                                        <h3
                                            class="text-primary fw-semibold text-decoration-underline link-underline-success">
                                            Sign Up</h3>
                                    </div>
                                    <p class="text-muted">Sign up for a new Account</p>
                                </div>
                                <div class="p-4">
                                    <form>
                                        <div class="form-group">
                                            <label for="firstname">Username <span class="text-danger">*</span></label>
                                            <input class="form-control" id="firstname" placeholder="First Name"
                                                required="" type="text" />
                                        </div>
                                        <div class="form-group">
                                            <label for="email">Email <span class="text-danger">*</span></label>
                                            <input class="form-control" id="email" placeholder="Enter Email" required=""
                                                type="email" />
                                        </div>
                                        <div class="form-group">
                                            <label for="userpassword">Password <span
                                                    class="text-danger">*</span></label>
                                            <input class="form-control" id="userpassword" placeholder="Enter password"
                                                required="" type="password" />
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" id="flexCheckDefault" type="checkbox"
                                                value="" />
                                            <label class="form-check-label" for="flexCheckDefault">
                                                Remember me
                                            </label>
                                        </div>
                                        <div class="mb-3 form-check">
                                            <input class="form-check-input" id="exampleCheck1" type="checkbox">
                                            <label class="form-check-label fw-semibold text-muted" for="exampleCheck1">I
                                                Accept <a class="text-success" href="/#">Terms And Condition</a></label>
                                            </input></div>
                                        <div class="d-grid mt-3">
                                            <button class="btn btn-primary" type="submit">Sign Up</button>
                                        </div>
                                        <p class="text-center mt-4">Already have an account? <a
                                                class="text-primary fw-semibold" href="/login">Login</a></p>
                                        <div class="mt-4 mb-0 text-center">
                                            <p class="mb-0"></p>
                                        </div>
                                    </form>
                                    <!-- end form -->
                                </div>
                            </div>
                        </div>
                        <!-- end card -->
                    </div>
                    <!-- end col -->
                </div>
                <!-- end row -->
            </div>
        </div>
        <div class="home-icon position-absolute">
            <a class="text-light" href="/index"><i class="ri-home-4-fill align-middle"></i></a>
        </div>
    </section>
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>

</html>